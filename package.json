{
  "name": "branchmaid",
  "version": "0.0.0",
  "description": "Tidy up stale git branches safely",
  "license": "MIT",
  "author": "Aditya Verma",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "bin": {
    "branchmaid": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "picocolors": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityaverma/branchmaid.git"
  },
  "homepage": "https://github.com/adityaverma/branchmaid#readme",
  "bugs": {
    "url": "https://github.com/adityaverma/branchmaid/issues"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "git",
    "branches",
    "cleanup",
    "cli",
    "prune"
  ]
}
